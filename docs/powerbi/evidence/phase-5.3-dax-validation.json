  "queryDefinitions": {
    "globalProducts": "EVALUATE SUMMARIZECOLUMNS('DimProduto'[product_id],'DimProduto'[sku],'DimProduto'[name], <measure and independent-column expressions>)",
    "janSepProducts": "EVALUATE SUMMARIZECOLUMNS('DimProduto'[product_id],'DimProduto'[sku],'DimProduto'[name], FILTER(ALL('DimCalendario'[Data]), Data>=DATE(2026,1,1)&&Data<=DATE(2026,9,30)), <same expressions>)",
    "categories": "EVALUATE SUMMARIZECOLUMNS('DimProduto'[category_code],'DimProduto'[category_name], <same expressions>)",
    "independentRevenueBefore": "VAR CompletedOrders=CALCULATETABLE(VALUES(FatoPedidos[sales_order_id]),KEEPFILTERS(order_status='completed')) RETURN CALCULATE(SUMX(FatoItensPedido,fulfilled_quantity*(unit_sale_price-item_discount_amount/quantity)),TREATAS(CompletedOrders,FatoItensPedido[sales_order_id]))",
    "independentReturns": "SUM(returned_commercial_value_x1e8)/1e8 with USERELATIONSHIP(FatoDevolucoes[order_date],DimCalendario[Data])",
    "independentCogs": "SUM(fulfillment_cogs_x1e8)/1e8 with completed status and USERELATIONSHIP(FatoCustoFulfillment[order_date],DimCalendario[Data])",
    "independentSellableReversal": "SUM(sellable_cogs_reversal_x1e8)/1e8 with USERELATIONSHIP(FatoDevolucoes[order_date],DimCalendario[Data])",
    "groupingOrderNote": "SUMMARIZECOLUMNS agrupa produto/categoria primeiro e aplica filter tables depois."
  },
