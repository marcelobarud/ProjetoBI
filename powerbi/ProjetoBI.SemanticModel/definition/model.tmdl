model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["DimCalendario","DimCanal","DimCliente","DimLoja","DimProduto","FatoItensPedido","FatoPedidos"]

ref table DimProduto
ref table DimLoja
ref table DimCliente
ref table DimCanal
ref table FatoItensPedido
ref table FatoPedidos
ref table DimCalendario

ref cultureInfo pt-BR
