	partition FatoDevolucoes = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("127.0.0.1:5432", "projeto_bi"),
					data_query = "WITH item_discount AS (SELECT sales_order_id, sales_order_item_id, sum(amount) AS discount_amount FROM sales.applied_discounts GROUP BY sales_order_id, sales_order_item_id), fulfillment_history AS (SELECT fulfillment_item_id, count(*) AS movement_count, round(sum(abs(quantity_delta)::numeric * unit_cost) / nullif(sum(abs(quantity_delta)), 0), 8) AS historical_unit_cost FROM inventory.stock_movements WHERE movement_type = 'fulfillment' GROUP BY fulfillment_item_id), return_movement AS (SELECT return_item_id, count(*) AS movement_count, sum(abs(quantity_delta)::numeric * unit_cost) AS return_cost FROM inventory.stock_movements WHERE movement_type = 'customer_return' AND return_item_id IS NOT NULL GROUP BY return_item_id) SELECT ri.return_item_id, ri.return_id, ri.sales_order_id, ri.sales_order_item_id, ri.source_fulfillment_item_id, fi.fulfillment_id AS source_fulfillment_id, i.product_id, o.customer_id, o.store_id, o.sales_channel_id, o.order_status, r.status AS return_status, r.reason_code AS return_reason_code, ri.item_condition, ri.stock_destination, ri.quantity_requested, ri.quantity_approved, ri.quantity_received, i.quantity AS order_item_quantity, i.unit_sale_price, coalesce(d.discount_amount, 0::numeric) AS applied_discount_amount, r.requested_at AT TIME ZONE 'America/Sao_Paulo' AS return_requested_at_local, ri.received_at AT TIME ZONE 'America/Sao_Paulo' AS return_received_at_local, (ri.received_at AT TIME ZONE 'America/Sao_Paulo')::date AS return_received_date, (o.placed_at AT TIME ZONE 'America/Sao_Paulo')::date AS order_date, coalesce(rm.movement_count, 0)::bigint AS return_movement_count, coalesce(rm.return_cost * 100000000, 0)::bigint AS return_movement_cost_x1e8, coalesce(fh.movement_count, 0)::bigint AS source_fulfillment_movement_count, (fh.historical_unit_cost * 100000000)::bigint AS source_historical_unit_cost_x1e8, CASE WHEN o.order_status = 'completed' AND ri.stock_destination = 'sellable' THEN coalesce(rm.return_cost * 100000000, 0)::bigint ELSE 0::bigint END AS sellable_cogs_reversal_x1e8, CASE WHEN o.order_status = 'completed' AND ri.quantity_received > 0 AND ri.stock_destination IN ('quarantine', 'repair', 'discard') THEN (ri.quantity_received::numeric * fh.historical_unit_cost * 100000000)::bigint ELSE 0::bigint END AS non_sellable_loss_x1e8, CASE WHEN o.order_status = 'completed' THEN round(ri.quantity_received::numeric * (i.unit_sale_price - coalesce(d.discount_amount, 0::numeric) / nullif(i.quantity, 0)) * 100000000)::bigint ELSE 0::bigint END AS returned_commercial_value_x1e8 FROM after_sales.return_items AS ri JOIN after_sales.returns AS r USING (return_id, sales_order_id) JOIN sales.sales_orders AS o USING (sales_order_id) JOIN sales.sales_order_items AS i USING (sales_order_id, sales_order_item_id) LEFT JOIN item_discount AS d USING (sales_order_id, sales_order_item_id) LEFT JOIN logistics.fulfillment_items AS fi ON fi.fulfillment_item_id = ri.source_fulfillment_item_id LEFT JOIN fulfillment_history AS fh ON fh.fulfillment_item_id = ri.source_fulfillment_item_id LEFT JOIN return_movement AS rm USING (return_item_id)",
					data = Value.NativeQuery(Source, data_query, null, [EnableFolding = true]),
					typed = Table.TransformColumnTypes(data, {{"quantity_requested", Int64.Type}, {"quantity_approved", Int64.Type}, {"quantity_received", Int64.Type}, {"return_requested_at_local", type datetime}, {"return_received_at_local", type datetime}, {"return_received_date", type date}, {"order_date", type date}, {"return_movement_count", Int64.Type}, {"return_movement_cost_x1e8", Int64.Type}, {"source_fulfillment_movement_count", Int64.Type}, {"source_historical_unit_cost_x1e8", Int64.Type}, {"sellable_cogs_reversal_x1e8", Int64.Type}, {"non_sellable_loss_x1e8", Int64.Type}, {"returned_commercial_value_x1e8", Int64.Type}, {"unit_sale_price", Currency.Type}, {"applied_discount_amount", Currency.Type}})
				in
					typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

