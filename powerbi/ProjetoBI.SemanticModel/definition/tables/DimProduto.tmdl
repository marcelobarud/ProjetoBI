	partition DimProduto = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("127.0.0.1:5432", "projeto_bi"),
					products_query = "SELECT p.*, c.category_code, c.name AS category_name, c.parent_category_id, parent.category_code AS parent_category_code, parent.name AS parent_category_name, c.is_active AS category_is_active FROM catalog.products AS p LEFT JOIN catalog.categories AS c ON c.category_id = p.category_id LEFT JOIN catalog.categories AS parent ON parent.category_id = c.parent_category_id",
					products_with_categories = Value.NativeQuery(Source, products_query, null, [EnableFolding = true])
				in
				products_with_categories

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
