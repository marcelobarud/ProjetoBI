	partition FatoCustoFulfillment = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("127.0.0.1:5432", "projeto_bi"),
					data_query = "SELECT m.stock_movement_id, m.fulfillment_item_id, fi.fulfillment_id, fi.sales_order_id, fi.sales_order_item_id, m.product_id, m.stock_location_id, m.movement_type, m.quantity_delta, abs(m.quantity_delta) AS quantity_fulfilled, (m.unit_cost * 100000000)::bigint AS unit_cost_x1e8, (abs(m.quantity_delta)::numeric * m.unit_cost * 100000000)::bigint AS fulfillment_cogs_x1e8, to_char(m.occurred_at AT TIME ZONE 'UTC', 'YYYY-MM-DD') || 'T' || to_char(m.occurred_at AT TIME ZONE 'UTC', 'HH24:MI:SS.US') || 'Z' AS occurred_at_utc_iso, m.occurred_at AT TIME ZONE 'America/Sao_Paulo' AS movement_datetime_local, (m.occurred_at AT TIME ZONE 'America/Sao_Paulo')::date AS movement_date, (o.placed_at AT TIME ZONE 'America/Sao_Paulo')::date AS order_date, o.order_status, o.customer_id, o.store_id, o.sales_channel_id FROM inventory.stock_movements AS m JOIN logistics.fulfillment_items AS fi USING (fulfillment_item_id) JOIN sales.sales_orders AS o USING (sales_order_id) WHERE m.movement_type = 'fulfillment'",
					data = Value.NativeQuery(Source, data_query, null, [EnableFolding = true]),
					typed = Table.TransformColumnTypes(data, {{"quantity_delta", Int64.Type}, {"quantity_fulfilled", Int64.Type}, {"unit_cost_x1e8", Int64.Type}, {"fulfillment_cogs_x1e8", Int64.Type}, {"movement_datetime_local", type datetime}, {"movement_date", type date}, {"order_date", type date}})
				in
					typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
