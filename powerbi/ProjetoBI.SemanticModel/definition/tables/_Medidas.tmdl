table _Medidas
	lineageTag: f7c8fdce-971a-4906-847e-1e8b96afaafc

	/// Contagem distinta de pedidos no grão do cabeçalho. Respeita data, canal, cliente e loja; retorna em
	/// branco sob filtro de produto/categoria para evitar atribuição indevida.
	measure 'Total de Pedidos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				DISTINCTCOUNT ( 'FatoPedidos'[sales_order_id] )
			)
		formatString: #,0
		displayFolder: 01 | Pedidos
		lineageTag: b3aa7829-f66b-42a3-854a-9674d61a5150

	/// Contagem distinta de pedidos cujo status atual/final é completed; não representa reconstrução
	/// histórica do status.
	measure 'Pedidos Concluídos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					DISTINCTCOUNT ( 'FatoPedidos'[sales_order_id] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			)
		formatString: #,0
		displayFolder: 01 | Pedidos
		lineageTag: 1eb7688e-9b39-4309-862c-f745a3b0131b

	/// Contagem distinta de pedidos cujo status atual/final é cancelled.
	measure 'Pedidos Cancelados' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					DISTINCTCOUNT ( 'FatoPedidos'[sales_order_id] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "cancelled" )
				)
			)
		formatString: #,0
		displayFolder: 01 | Pedidos
		lineageTag: f53795d4-5b9f-413d-aa85-91bc96b6938d

	/// Contagem distinta de pedidos cujo status atual/final é confirmed.
	measure 'Pedidos Confirmados' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					DISTINCTCOUNT ( 'FatoPedidos'[sales_order_id] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "confirmed" )
				)
			)
		formatString: #,0
		displayFolder: 01 | Pedidos
		lineageTag: 2e1f9bd1-e2ae-47ef-82bb-8d340fe972db

	/// Pedidos completed divididos pelo total de pedidos no mesmo contexto. Retorna em branco quando não há
	/// denominador.
	measure 'Taxa de Conclusão' = DIVIDE ( [Pedidos Concluídos], [Total de Pedidos] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 | Indicadores Percentuais
		lineageTag: 78da4146-8b35-422c-8089-ea285d722c4d

	/// Pedidos cancelled divididos pelo total de pedidos no mesmo contexto. Retorna em branco quando não há
	/// denominador.
	measure 'Taxa de Cancelamento' = DIVIDE ( [Pedidos Cancelados], [Total de Pedidos] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 | Indicadores Percentuais
		lineageTag: 7840c400-e42f-4ff4-b679-6931d4e9d9ad

	/// Participação do status atual/final no total de pedidos preservando data, canal, cliente e loja. O
	/// denominador remove somente o filtro de status; não usar como participação de canal ou produto.
	measure 'Participação de Pedidos por Status' =
			DIVIDE (
				[Total de Pedidos],
				CALCULATE (
					[Total de Pedidos],
					REMOVEFILTERS ( 'FatoPedidos'[order_status] )
				)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 | Indicadores Percentuais
		lineageTag: bf976b07-2df5-4477-8abd-00b28b962ef0

	/// Soma total_amount para todos os status, incluindo frete. É valor comercial de cabeçalho, não
	/// faturamento realizado, caixa ou receita líquida após devoluções.
	measure 'Valor Total dos Pedidos — Todos os Status' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					SUM ( 'FatoPedidos'[total_amount] ),
					REMOVEFILTERS ( 'FatoPedidos'[order_status] )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 02 | Faturamento
		lineageTag: 6959479a-6a8e-4e6e-a167-d58df4643919

	/// Soma subtotal_amount de pedidos completed antes de descontos, no grão do cabeçalho.
	measure 'Valor Bruto de Produtos — Pedidos Concluídos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					SUM ( 'FatoPedidos'[subtotal_amount] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 02 | Faturamento
		lineageTag: 17f26cae-ad0f-4d24-b3d7-0d5c1553a20c

	/// Soma discount_amount de pedidos completed; é desconto de cabeçalho, não desconto rateado por item.
	measure 'Descontos — Pedidos Concluídos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					SUM ( 'FatoPedidos'[discount_amount] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 03 | Descontos
		lineageTag: 82b82c1d-43bc-44d6-bdf2-756434280071

	/// Valor bruto de produtos completed menos descontos de cabeçalho completed. Ainda não desconta
	/// devoluções recebidas e não representa receita analítica pós-devolução.
	measure 'Receita Líquida de Produtos — Antes de Devoluções' =
			VAR ValorBruto = [Valor Bruto de Produtos — Pedidos Concluídos]
			VAR Descontos = [Descontos — Pedidos Concluídos]
			RETURN
				IF (
					ISBLANK ( ValorBruto ) && ISBLANK ( Descontos ),
					BLANK (),
					ValorBruto - Descontos
				)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 02 | Faturamento
		lineageTag: d30fcb92-8f44-43a7-9a24-af740973f81a

	/// Soma shipping_amount de pedidos completed, separada do valor líquido de produtos.
	measure 'Frete Cobrado — Pedidos Concluídos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					SUM ( 'FatoPedidos'[shipping_amount] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 02 | Faturamento
		lineageTag: 1d814362-30eb-4c00-b1d7-a468d6cefb5d

	/// Soma total_amount de pedidos completed, incluindo frete. Não equivale a pagamentos capturados nem a
	/// valor após devoluções.
	measure 'Valor Total — Pedidos Concluídos' =
			IF (
				ISFILTERED ( 'DimProduto' ),
				BLANK (),
				CALCULATE (
					SUM ( 'FatoPedidos'[total_amount] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 02 | Faturamento
		lineageTag: fc10a320-c740-4a2c-897b-26ec81e95c79

	/// Valor total de pedidos completed, incluindo frete, dividido pela contagem de pedidos completed. Em
	/// branco sem denominador.
	measure 'Ticket Médio — Pedidos Concluídos' = DIVIDE ( [Valor Total — Pedidos Concluídos], [Pedidos Concluídos] )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 04 | Ticket Médio
		lineageTag: 92713f59-c44c-41f9-b176-26dc8668413b

	/// Total de pedidos do período equivalente no ano anterior, pelo estado atual/final, somente quando há
	/// contexto de calendário.
	measure 'Pedidos no Ano Anterior' =
			IF (
				NOT ISFILTERED ( 'DimCalendario' ),
				BLANK (),
				CALCULATE ( [Total de Pedidos], DATEADD ( 'DimCalendario'[Data], -1, YEAR ) )
			)
		formatString: #,0
		displayFolder: 06 | Inteligência Temporal
		lineageTag: e07ddd09-2e1b-4770-80e7-11d951142504

	/// Diferença entre pedidos do contexto atual e do período equivalente no ano anterior. Em branco quando
	/// não há período anterior disponível.
	measure 'Variação Absoluta de Pedidos YoY' =
			VAR PedidosAnoAnterior = [Pedidos no Ano Anterior]
			RETURN
				IF (
					ISBLANK ( PedidosAnoAnterior ) || ISBLANK ( [Total de Pedidos] ),
					BLANK (),
					[Total de Pedidos] - PedidosAnoAnterior
				)
		formatString: #,0;(#,0);0
		displayFolder: 06 | Inteligência Temporal
		lineageTag: 72349db9-f2ca-407e-b896-24165fcbca1f

	/// Variação absoluta de pedidos YoY dividida pelos pedidos do ano anterior. Em branco sem período ou
	/// denominador válido.
	measure 'Variação Percentual de Pedidos YoY' = DIVIDE ( [Variação Absoluta de Pedidos YoY], [Pedidos no Ano Anterior] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 | Inteligência Temporal
		lineageTag: 54d90c0e-3624-4c8a-b526-d50677829c54

	/// Total de pedidos acumulados desde janeiro até a última data do contexto no ano comercial, sem usar
	/// TODAY().
	measure 'Pedidos YTD' = CALCULATE ( [Total de Pedidos], DATESYTD ( 'DimCalendario'[Data] ) )
		formatString: #,0
		displayFolder: 06 | Inteligência Temporal
		lineageTag: 8ebcb69a-f0a9-4d7a-b26f-2f518ea05552

	/// Receita líquida de produtos antes de devoluções no período equivalente do ano anterior. Em branco
	/// sem contexto de calendário ou período comparável.
	measure 'Receita de Produtos no Ano Anterior — Antes de Devoluções' =
			IF (
				NOT ISFILTERED ( 'DimCalendario' ),
				BLANK (),
				CALCULATE (
					[Receita Líquida de Produtos — Antes de Devoluções],
					DATEADD ( 'DimCalendario'[Data], -1, YEAR )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 06 | Inteligência Temporal
		lineageTag: 8ed5159c-6aee-4438-9e4e-d0fff0eace32

	/// Diferença de receita líquida de produtos antes de devoluções contra o período equivalente do ano
	/// anterior.
	measure 'Variação Absoluta de Receita YoY — Antes de Devoluções' =
			VAR ReceitaAnoAnterior = [Receita de Produtos no Ano Anterior — Antes de Devoluções]
			RETURN
				IF (
					ISBLANK ( ReceitaAnoAnterior ) || ISBLANK ( [Receita Líquida de Produtos — Antes de Devoluções] ),
					BLANK (),
					[Receita Líquida de Produtos — Antes de Devoluções] - ReceitaAnoAnterior
				)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 06 | Inteligência Temporal
		lineageTag: a279f7a7-b8be-4f9d-ad6e-88d546dfc297

	/// Variação absoluta da receita YoY dividida pela receita do ano anterior. Em branco sem período ou
	/// denominador válido.
	measure 'Variação Percentual de Receita YoY — Antes de Devoluções' =
			DIVIDE (
				[Variação Absoluta de Receita YoY — Antes de Devoluções],
				[Receita de Produtos no Ano Anterior — Antes de Devoluções]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 | Inteligência Temporal
		lineageTag: fb8ada42-d397-466d-8009-ec560afcedbe

	/// Receita líquida de produtos antes de devoluções acumulada desde janeiro até a última data
	/// selecionada no ano comercial.
	measure 'Receita YTD — Antes de Devoluções' =
			CALCULATE (
				[Receita Líquida de Produtos — Antes de Devoluções],
				DATESYTD ( 'DimCalendario'[Data] )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 06 | Inteligência Temporal
		lineageTag: eafaf163-841d-4356-91bb-d142c0deb2f4

	/// Receita líquida acumulada no mesmo intervalo YTD do ano anterior. Para dataset 2026, comparar
	/// janeiro–setembro de 2026 com janeiro–setembro de 2025.
	measure 'Receita YTD Ano Anterior — Antes de Devoluções' =
			IF (
				NOT ISFILTERED ( 'DimCalendario' ),
				BLANK (),
				CALCULATE (
					[Receita Líquida de Produtos — Antes de Devoluções],
					DATEADD ( DATESYTD ( 'DimCalendario'[Data] ), -1, YEAR )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 06 | Inteligência Temporal
		lineageTag: e34c0415-1423-4a78-bab9-845504b46710

	/// Variação percentual do YTD contra a mesma janela do ano anterior. Em branco quando a janela ou
	/// denominador anterior não está disponível.
	measure 'Variação Percentual de Receita YTD YoY — Antes de Devoluções' =
			VAR ReceitaYtdAnoAnterior = [Receita YTD Ano Anterior — Antes de Devoluções]
			VAR ReceitaYtdAtual = [Receita YTD — Antes de Devoluções]
			RETURN
				IF (
					ISBLANK ( ReceitaYtdAnoAnterior ) || ISBLANK ( ReceitaYtdAtual ),
					BLANK (),
					DIVIDE ( ReceitaYtdAtual - ReceitaYtdAnoAnterior, ReceitaYtdAnoAnterior )
				)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 | Inteligência Temporal
		lineageTag: 8f244398-987d-45c3-ab36-ed01bb98e5ad

	/// Contagem de linhas comerciais no grão sales_order_item_id. Responde a produto/categoria e às
	/// dimensões conformadas disponíveis.
	measure 'Total de Linhas de Itens' = COUNTROWS ( 'FatoItensPedido' )
		formatString: #,0
		displayFolder: 05 | Produtos e Itens
		lineageTag: f7ae700c-8918-4bc2-b211-0a73c11553c8

	/// Soma da quantidade originalmente pedida nos itens. Não equivale necessariamente a unidades
	/// atendidas, vendidas após cancelamento ou líquidas de devoluções.
	measure 'Unidades Pedidas' = SUM ( 'FatoItensPedido'[quantity] )
		formatString: #,0
		displayFolder: 05 | Produtos e Itens
		lineageTag: 7f84aa04-997c-469d-92c3-37e309511949

	/// Contagem distinta de pedidos representados pelas linhas de item no contexto de produto/categoria.
	/// Não é o total de pedidos do cabeçalho.
	measure 'Pedidos Distintos com Itens no Contexto' = DISTINCTCOUNT ( 'FatoItensPedido'[sales_order_id] )
		formatString: #,0
		displayFolder: 05 | Produtos e Itens
		lineageTag: 4e1ea9c2-ec1e-41d0-8706-1333c79aeb46

	/// Unidades pedidas para produto/categoria divididas pelas unidades em todos os produtos, preservando
	/// calendário, canal, cliente e loja. Em branco sem unidades no denominador.
	measure 'Participação de Unidades no Contexto de Produto' =
			DIVIDE (
				[Unidades Pedidas],
				CALCULATE ( [Unidades Pedidas], REMOVEFILTERS ( 'DimProduto' ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 | Indicadores Percentuais
		lineageTag: 07845f27-8750-4bae-b491-2f9f9cb1b42f

	/// Grão: uma linha em FatoDevolucoes; unidade: itens. Usa a data de recebimento ativa; itens sem recebimento permanecem no total sem filtro de data e ficam fora de períodos de evento. Respeita dimensões conformadas; BLANK quando não há linhas. Baseline 09_returns.sql.
	measure 'Itens de Devolução' = COUNTROWS ( 'FatoDevolucoes' )
		formatString: #,0
		displayFolder: 08 | Devoluções
		lineageTag: 1162de3d-46f7-46a1-985e-3b1c4ddb71bc

	/// Grão: quantity_received por return_item_id; unidade: unidades recebidas. Perspectiva de evento pela data de recebimento ativa; quantidade zero não é devolução efetivada. Respeita destino e dimensões; BLANK sem recebimentos. Baseline 09_returns.sql.
	measure 'Unidades Recebidas em Devolução' = SUM ( 'FatoDevolucoes'[quantity_received] )
		formatString: #,0
		displayFolder: 08 | Devoluções
		lineageTag: 8fed3fa0-b2b2-401f-a927-022809237bf5

	/// Grão: return_item_id recebido e pedido completed; unidade: BRL. Perspectiva de evento pela data de recebimento ativa. Soma primeiro os inteiros escalados por 10^8 e converte após agregar. Filtros de destino e dimensões preservados; BLANK sem valor. Baseline 09_returns.sql e 11_cost_and_margin.sql.
	measure 'Valor Comercial Devolvido — Data do Recebimento' = DIVIDE ( SUM ( 'FatoDevolucoes'[returned_commercial_value_x1e8] ), 100000000 )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 08 | Devoluções
		lineageTag: 489d279f-563e-4984-b6ea-733b95c3b6b7

	/// Grão: return_item_id recebido e pedido completed; unidade: BRL. Perspectiva de coorte: USERELATIONSHIP ativa order_date e substitui a data de recebimento. Soma inteiros x10^8 antes da conversão; BLANK sem valor. Baseline 09_returns.sql e 11_cost_and_margin.sql.
	measure 'Valor Comercial Devolvido — Data do Pedido' =
			CALCULATE (
				[Valor Comercial Devolvido — Data do Recebimento],
				USERELATIONSHIP ( 'FatoDevolucoes'[order_date], 'DimCalendario'[Data] )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 08 | Devoluções
		lineageTag: 3fa8c584-0eb7-4fbb-8899-6137da1b3335

	/// Grão: return_item_id; unidade: BRL. Quarantine, repair ou discard pela data de recebimento ativa; indicador informativo que permanece no COGS analítico, sem dedução adicional. Preserva filtros dimensionais; BLANK sem perda. Baseline 11_cost_and_margin.sql.
	measure 'Perda Non-Sellable — Data do Recebimento' = DIVIDE ( SUM ( 'FatoDevolucoes'[non_sellable_loss_x1e8] ), 100000000 )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: 21bd234f-76dc-4295-a0d2-d684d06f3a28

	/// Grão: return_item_id; unidade: BRL. Coorte do pedido de origem, substitui a data de recebimento. Soma inteiros x10^8 antes da conversão; perda informativa incluída no COGS ajustado. BLANK sem perda. Baseline 11_cost_and_margin.sql.
	measure 'Perda Non-Sellable — Data do Pedido' =
			CALCULATE (
				[Perda Non-Sellable — Data do Recebimento],
				USERELATIONSHIP ( 'FatoDevolucoes'[order_date], 'DimCalendario'[Data] )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: d561259c-dcad-470d-8983-8b04c6d21d6d

	/// Grão: stock_movement_id; unidade: BRL. Custo canônico escalado por 10^8, sem restrição de status, pela data de movimento ativa. Mantém filtros dimensionais; BLANK sem movimentos. Baseline 11_cost_and_margin.sql.
	measure 'COGS de Fulfillment — Data do Movimento' = DIVIDE ( SUM ( 'FatoCustoFulfillment'[fulfillment_cogs_x1e8] ), 100000000 )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: e0847158-adbe-4c0c-bb8c-8edafa7f22a6

	/// Grão: stock_movement_id completed; unidade: BRL. Perspectiva operacional pela data do movimento. Mantém filtros de status com KEEPFILTERS; agrega x10^8 antes de converter; BLANK sem custo elegível. Baseline 11_cost_and_margin.sql.
	measure 'COGS Original Concluído — Data do Movimento' =
			CALCULATE (
				[COGS de Fulfillment — Data do Movimento],
				KEEPFILTERS ( 'FatoCustoFulfillment'[order_status] = "completed" )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: 0d60d968-da5a-4920-9941-de87e3b881a2

	/// Grão: stock_movement_id completed; unidade: BRL. Coorte do pedido: USERELATIONSHIP ativa order_date e substitui movement_date. Agrega x10^8 antes de converter; BLANK sem custo elegível. Baseline 11_cost_and_margin.sql.
	measure 'COGS Original Concluído — Data do Pedido' =
			CALCULATE (
				[COGS de Fulfillment — Data do Movimento],
				KEEPFILTERS ( 'FatoCustoFulfillment'[order_status] = "completed" ),
				USERELATIONSHIP ( 'FatoCustoFulfillment'[order_date], 'DimCalendario'[Data] )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: 8ed8b98f-109e-4add-94cb-26c56dd12b93

	/// Grão: return_item sellable reintegrado; unidade: BRL. Perspectiva de evento pela data de recebimento. Agrega inteiros x10^8; não inclui destinos não vendáveis; BLANK sem reversões. Baseline 11_cost_and_margin.sql.
	measure 'Reversão COGS Sellable — Data do Recebimento' = DIVIDE ( SUM ( 'FatoDevolucoes'[sellable_cogs_reversal_x1e8] ), 100000000 )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: a326a6dd-d41c-451f-afb9-d864d79a6c7f

	/// Grão: return_item sellable reintegrado; unidade: BRL. Perspectiva de coorte por order_date, substitui a data de recebimento. Soma inteiros x10^8; BLANK sem reversões. Baseline 11_cost_and_margin.sql.
	measure 'Reversão COGS Sellable — Data do Pedido' =
			CALCULATE (
				[Reversão COGS Sellable — Data do Recebimento],
				USERELATIONSHIP ( 'FatoDevolucoes'[order_date], 'DimCalendario'[Data] )
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: 179137cd-cbca-477b-abb5-1b3d1af6611e

	/// Grão: linha comercial atendida em pedido completed; unidade: BRL. Preço histórico líquido do desconto atribuído ao item multiplicado pelas unidades atendidas. Coorte pela order_date; TREATAS seleciona pedidos completed sem relação entre fatos. Respeita produto/categoria, canal, cliente e loja; BLANK sem itens. Baseline 05_sales_by_category.sql, 06_product_performance.sql e 11_cost_and_margin.sql.
	measure 'Receita de Produtos — Antes de Devoluções (Itens)' =
			VAR PedidosConcluidos =
				CALCULATETABLE (
					VALUES ( 'FatoPedidos'[sales_order_id] ),
					KEEPFILTERS ( 'FatoPedidos'[order_status] = "completed" )
				)
			RETURN
				CALCULATE (
					SUMX (
						'FatoItensPedido',
						'FatoItensPedido'[fulfilled_quantity]
							* (
								'FatoItensPedido'[unit_sale_price]
									- DIVIDE ( 'FatoItensPedido'[item_discount_amount], 'FatoItensPedido'[quantity], 0 )
							)
					),
					TREATAS ( PedidosConcluidos, 'FatoItensPedido'[sales_order_id] )
				)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 10 | Lucro e Margem
		lineageTag: c8139fae-1000-46e0-b03e-1d0c12f4ceb9

	/// Grão: item atendido menos devoluções recebidas; unidade: BRL. Receita por produto após devoluções = receita atribuída ao item antes das devoluções menos valor devolvido recebido. Todos os componentes usam coorte do pedido; preserva produto/categoria e dimensões; BLANK sem receita. Baseline 11_cost_and_margin.sql.
	measure 'Receita Analítica Após Devoluções' =
			VAR ReceitaAntes = [Receita de Produtos — Antes de Devoluções (Itens)]
			VAR ValorDevolvido = [Valor Comercial Devolvido — Data do Pedido]
			RETURN
				IF ( ISBLANK ( ReceitaAntes ), BLANK (), ReceitaAntes - COALESCE ( ValorDevolvido, 0 ) )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 10 | Lucro e Margem
		lineageTag: 8f3c4901-f129-4073-b30c-6a3fbf1609e7

	/// Grão: movimentos fulfillment completed menos return_item sellable reintegrado; unidade: BRL. Ambos por coorte do pedido. A perda non-sellable permanece no COGS e não é subtraída de novo. Inteiros x10^8 antes de converter; BLANK sem COGS. Baseline 11_cost_and_margin.sql.
	measure 'COGS Analítico Ajustado' =
			VAR COGSOriginal = [COGS Original Concluído — Data do Pedido]
			VAR ReversaoSellable = [Reversão COGS Sellable — Data do Pedido]
			RETURN
				IF ( ISBLANK ( COGSOriginal ), BLANK (), COGSOriginal - COALESCE ( ReversaoSellable, 0 ) )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 09 | Custos e COGS
		lineageTag: d7229704-aa76-478f-9534-bfdb4d5a1581

	/// Grão: universo completed por produto; unidade: BRL. Receita líquida após devoluções menos COGS ajustado por coorte; exclui frete e não deduz perdas non-sellable novamente. BLANK sem receita ou custo. Baseline 11_cost_and_margin.sql.
	measure 'Lucro Bruto Analítico' =
			VAR Receita = [Receita Analítica Após Devoluções]
			VAR COGS = [COGS Analítico Ajustado]
			RETURN
				IF ( ISBLANK ( Receita ) || ISBLANK ( COGS ), BLANK (), Receita - COGS )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 10 | Lucro e Margem
		lineageTag: 7c102aef-f5c4-4ea9-8872-64ce1aaa509a

	/// Grão: universo completed por produto; unidade: percentual. Lucro analítico dividido pela receita após devoluções, ambos por coorte. DIVIDE retorna BLANK sem denominador; filtros dimensionais preservados. Baseline 11_cost_and_margin.sql.
	measure 'Margem Bruta Analítica' = DIVIDE ( [Lucro Bruto Analítico], [Receita Analítica Após Devoluções] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10 | Lucro e Margem
		lineageTag: 6a0f3041-d3ae-49a4-adf2-356a6cd4cd6f

	/// Grão: universo completed por produto; unidade: percentual. COGS ajustado por coorte dividido pela receita pós-devoluções; DIVIDE retorna BLANK sem denominador; filtros dimensionais são comuns. Baseline 11_cost_and_margin.sql.
	measure 'Participação do COGS Ajustado na Receita' = DIVIDE ( [COGS Analítico Ajustado], [Receita Analítica Após Devoluções] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10 | Lucro e Margem
		lineageTag: 648a7251-090e-4886-b673-2fe9ec489fbf

	/// Grão: return_item recebido; unidade: percentual da receita atribuída antes de devoluções. Ambos por coorte; DIVIDE retorna BLANK sem receita; filtros dimensionais preservados. Baseline 11_cost_and_margin.sql.
	measure 'Percentual de Devoluções Comerciais' = DIVIDE ( [Valor Comercial Devolvido — Data do Pedido], [Receita de Produtos — Antes de Devoluções (Itens)] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10 | Lucro e Margem
		lineageTag: 1aa24d43-14d8-41d3-aa4c-e40d13a42855

	/// Grão: custo reintegrado sellable; unidade: percentual do COGS completed. Ambos por coorte; quarantine/repair/discard fora do numerador; DIVIDE retorna BLANK sem custo. Baseline 11_cost_and_margin.sql.
	measure 'Participação da Reversão Sellable no COGS' = DIVIDE ( [Reversão COGS Sellable — Data do Pedido], [COGS Original Concluído — Data do Pedido] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10 | Lucro e Margem
		lineageTag: f8e1e8d6-cd04-45bd-9c58-5627c7c57555

	/// Grão: perdas em destinos non-sellable; unidade: percentual do COGS ajustado. Ambos por coorte. Perda permanece dentro do COGS e não é nova dedução; DIVIDE retorna BLANK sem custo. Baseline 11_cost_and_margin.sql.
	measure 'Participação Non-Sellable no COGS Ajustado' = DIVIDE ( [Perda Non-Sellable — Data do Pedido], [COGS Analítico Ajustado] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10 | Lucro e Margem
		lineageTag: 20db82de-1d7a-4e36-a392-16ebe8ab3cc0

	/// Grão: coorte comercial de pedidos no YTD; unidade: BRL. DATESYTD no calendário do pedido, sem TODAY(); componentes preservam a data comercial. BLANK sem receita. Baseline 12_yoy_ytd.sql.
	measure 'Receita Analítica YTD' = CALCULATE ( [Receita Analítica Após Devoluções], DATESYTD ( 'DimCalendario'[Data] ) )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 5e555bc7-6896-41a9-9212-43093d3b9b73

	/// Grão: coorte no YTD equivalente do ano anterior; unidade: BRL. Requer contexto de calendário, desloca a janela YTD sem TODAY(); BLANK sem período comparável. Baseline 12_yoy_ytd.sql.
	measure 'Receita Analítica YTD Ano Anterior' =
			IF (
				NOT ISFILTERED ( 'DimCalendario' ),
				BLANK (),
				CALCULATE (
					[Receita Analítica Após Devoluções],
					DATEADD ( DATESYTD ( 'DimCalendario'[Data] ), -1, YEAR )
				)
			)
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 0d20643a-922c-4540-8626-61d6d33897e0

	/// Grão: janela YTD contra o mesmo período anterior; unidade: percentual. Usa receita pós-devoluções por coorte; DIVIDE retorna BLANK sem receita anterior. Baseline 12_yoy_ytd.sql.
	measure 'Variação Percentual de Receita Analítica YTD' = DIVIDE ( [Variação Absoluta de Receita Analítica YTD], [Receita Analítica YTD Ano Anterior] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 6a003bcb-af33-4664-bc2f-cd8c70610f08

	/// Grão: diferença da receita analítica acumulada na janela atual e anterior; unidade: BRL. BLANK sem uma das janelas; ambos preservam a coorte comercial. Baseline 12_yoy_ytd.sql.
	measure 'Variação Absoluta de Receita Analítica YTD' =
			VAR Atual = [Receita Analítica YTD]
			VAR Anterior = [Receita Analítica YTD Ano Anterior]
			RETURN
				IF ( ISBLANK ( Atual ) || ISBLANK ( Anterior ), BLANK (), Atual - Anterior )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 7872cfdb-c77c-4bb4-8fd0-b58ed9667e8d

	/// Grão: COGS ajustado acumulado no YTD da coorte comercial; unidade: BRL. DATESYTD no calendário do pedido, sem TODAY(); usa order_date nos fatos de custo e devolução. BLANK sem custo. Baseline 12_yoy_ytd.sql.
	measure 'COGS Analítico Ajustado YTD' = CALCULATE ( [COGS Analítico Ajustado], DATESYTD ( 'DimCalendario'[Data] ) )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: d76f8bb3-9901-4370-a2c1-ecd98bccf347

	/// Grão: lucro bruto analítico acumulado no YTD por coorte; unidade: BRL. Receita, devolução e custo usam a data do pedido; BLANK sem receita/custo; não deduz perdas outra vez. Baseline 12_yoy_ytd.sql.
	measure 'Lucro Bruto Analítico YTD' = CALCULATE ( [Lucro Bruto Analítico], DATESYTD ( 'DimCalendario'[Data] ) )
		formatString: $ #,##0.00;($ #,##0.00);$ 0.00
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 5f6f2cd7-b100-4d48-834b-66fc9713ad0d

	/// Grão: coorte de pedidos acumulada no YTD; unidade: percentual. Lucro acumulado dividido pela receita acumulada; nunca soma nem média percentuais mensais. DIVIDE retorna BLANK sem denominador. Baseline 12_yoy_ytd.sql.
	measure 'Margem Bruta Analítica YTD' = DIVIDE ( [Lucro Bruto Analítico YTD], [Receita Analítica YTD] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 11 | Análise Financeira Temporal
		lineageTag: 49b6da4a-16a6-4bd9-9c8a-3ae2e983f6f1

	column _Apoio
		isHidden
		lineageTag: 53774f27-39b1-42a1-8160-254efbc5075a
		sourceColumn: [_Apoio]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "_Apoio", BLANK () )
