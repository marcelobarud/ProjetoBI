	column FimDeSemana
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 39b385d1-919a-4d33-a6f9-4ad355f8a637
		summarizeBy: none
		sourceColumn: FimDeSemana

		annotation SummarizationSetBy = Automatic

	partition DimCalendario = m
		mode: import
		source =
				let
					DataInicial = #date(2023, 1, 1),
					DataFinal = #date(2026, 9, 30),
					ListaDatas = List.Dates(DataInicial, Duration.Days(DataFinal - DataInicial) + 1, #duration(1, 0, 0, 0)),
					Base = Table.FromColumns({ListaDatas}, {"Data"}),
					Tipos = Table.TransformColumnTypes(Base, {{"Data", type date}}, "pt-BR"),
					ComAno = Table.AddColumn(Tipos, "Ano", each Date.Year([Data]), Int64.Type),
					ComMesNumero = Table.AddColumn(ComAno, "MesNumero", each Date.Month([Data]), Int64.Type),
					ComNomeMes = Table.AddColumn(ComMesNumero, "NomeMes", each Date.ToText([Data], [Format = "MMMM", Culture = "pt-BR"]), type text),
					ComAnoMes = Table.AddColumn(ComNomeMes, "AnoMes", each Date.ToText([Data], [Format = "yyyy-MM", Culture = "en-US"]), type text),
					ComAnoMesOrdem = Table.AddColumn(ComAnoMes, "AnoMesOrdem", each [Ano] * 100 + [MesNumero], Int64.Type),
					ComTrimestreNumero = Table.AddColumn(ComAnoMesOrdem, "TrimestreNumero", each Number.RoundUp([MesNumero] / 3), Int64.Type),
					ComTrimestre = Table.AddColumn(ComTrimestreNumero, "Trimestre", each "T" & Text.From([TrimestreNumero], "en-US"), type text),
					ComAnoTrimestre = Table.AddColumn(ComTrimestre, "AnoTrimestre", each Text.From([Ano], "en-US") & "-" & [Trimestre], type text),
					ComAnoTrimestreOrdem = Table.AddColumn(ComAnoTrimestre, "AnoTrimestreOrdem", each [Ano] * 10 + [TrimestreNumero], Int64.Type),
					ComDiaNumero = Table.AddColumn(ComAnoTrimestreOrdem, "DiaNumero", each Date.Day([Data]), Int64.Type),
					ComDiaSemanaNumero = Table.AddColumn(ComDiaNumero, "DiaSemanaNumero", each Date.DayOfWeek([Data], Day.Monday) + 1, Int64.Type),
					ComNomeDiaSemana = Table.AddColumn(ComDiaSemanaNumero, "NomeDiaSemana", each Date.ToText([Data], [Format = "dddd", Culture = "pt-BR"]), type text),
					ComFimDeSemana = Table.AddColumn(ComNomeDiaSemana, "FimDeSemana", each [DiaSemanaNumero] >= 6, type logical)
				in
					ComFimDeSemana

	annotation PBI_NavigationStepName = List.Dates

	annotation PBI_ResultType = Table

